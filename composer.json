{
    "name": "royalty/royalty",
    "description": "royalty",
    "keywords": ["royalty"],
    "type": "project",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "^2.0.53",
        "yiisoft/yii2-symfonymailer": "^4.0",
        "yiister/yii2-gentelella": "^1.3.1",
        "yiisoft/yii2-jui": "^2.0.7",
        "yiisoft/yii2-imagine": "^2.2",
        "kartik-v/yii2-widget-select2": "^2.2.5",
        "kartik-v/yii2-widget-datepicker": "^1.4.8",
        "aki/yii2-bot-telegram": "*",
        "phpoffice/phpspreadsheet": "^4.2",
        "kartik-v/yii2-mpdf": "^1.0",
        "yiisoft/yii2-debug": "^2.1.25",
        "yiisoft/yii2-gii": "^2.2.6",
        "box/spout": "^3.3"
    },
    "require-dev": {
        "yiisoft/yii2-faker": "~2.0.0",
        "codeception/codeception": "^5.3.7",
        "codeception/module-asserts": "^3.3.0",
        "codeception/module-yii2": "^1.1.12",
        "codeception/module-filesystem": "^3.0.2",
        "codeception/verify": "^3.0",
        "symfony/browser-kit": "^6.4",
        "phpunit/phpunit": "^11.5.57"
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
